# Copiar a .env en la VPS (no commitear secretos).
VIDEO_ENGINE_API_KEY=cambia-esta-clave-larga
VIDEO_ENGINE_PORT=4100
VIDEO_STORAGE_ROOT=/data
VIDEO_USE_FAKE_PROVIDERS=false
# Opcional: misma Neon que el sitio para cola durable
# VIDEO_DATABASE_URL=postgresql://...
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
NODE_OPTIONS=--max-old-space-size=384
