# Copiar a apps/video-engine/.env (no commitear).
# Escritorio / craft completo — ver docs/architecture/video-engine-desktop.md

VIDEO_ENGINE_API_KEY=cambia-esta-clave-larga-y-ponela-igual-en-vercel
# 4100 suele estar reservado por Hyper-V en Windows → usá 4110
VIDEO_ENGINE_PORT=4110

# Ruta absoluta Windows (creá la carpeta si no existe)
VIDEO_STORAGE_ROOT=C:/Users/Valen/OneDrive/Desktop/Valen/Proyectos/historia-argentina/data/video-engine

VIDEO_USE_FAKE_PROVIDERS=false
VIDEO_RENDER_FAST=0
VIDEO_X264_PRESET=medium
VIDEO_X264_CRF=18

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

NODE_OPTIONS=--max-old-space-size=2048

# No pongas DATABASE_URL aquí. Solo si querés Postgres propio del engine:
# VIDEO_DATABASE_URL=postgresql://...
