{
  "name": "@museoargent/video-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');const p=require('path');const s=p.join('src','generated');const d=p.join('dist','generated');if(fs.existsSync(s)){fs.cpSync(s,d,{recursive:true});console.log('copied prisma client to dist/generated')}\"",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "worker": "tsx src/worker.main.ts",
    "cli": "tsx src/interface/cli/cli.ts",
    "test": "node --import tsx --test test/**/*.test.ts src/**/*.test.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@museoargent/video-contracts": "*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "openai": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
