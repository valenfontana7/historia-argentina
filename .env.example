# Postgres (Neon / Prisma / cualquier proveedor)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Cookie de sesión JWT (generá uno largo: openssl rand -base64 32)
AUTH_SECRET="reemplazar-con-secreto-largo-aleatorio"

# URL pública del sitio (sin barra final). Usá https://www.museoargent.com.ar
# en producción para alinear canonical/OG con el redirect apex → www.
NEXT_PUBLIC_SITE_URL="https://www.museoargent.com.ar"

# MercadoPago (credenciales de producción o de prueba)
MP_ACCESS_TOKEN=""
# Opcional: ID de un preapproval_plan ya creado (suscripción mensual)
MP_PREAPPROVAL_PLAN_ID=""

# Emails del creador: acceso admin (/admin/acceder) y precio reducido en MP (comma-separated)
MECENAS_CREATOR_EMAILS="tu@email.com"
# Monto ARS para checkout de creador (default 1)
MECENAS_CREATOR_PRECIO="1"

# Resend (emails de magic link y bienvenida)
RESEND_API_KEY=""
# Opcional: remitente verificado. Por defecto usa onboarding@resend.dev
RESEND_FROM="Argent <onboarding@resend.dev>"

# Google Search Console — meta tag de verificación (solo el código, sin comillas)
# Search Console → Configuración → Verificación → Etiqueta HTML → content="..."
GOOGLE_SITE_VERIFICATION=""

# Flag para desactivar la validación de mecenas en desarrollo (true/false)
NEXT_PUBLIC_SALTAR_MECENAS="false"

# --- Video engine (apps/video-engine) ---
# Misma DB o una dedicada. Si está vacío, el engine usa cola in-memory.
VIDEO_DATABASE_URL=""
# Misma key que apps/video-engine/.env (también autentica carousel vía media engine)
VIDEO_ENGINE_API_KEY="dev-video-engine-key"
VIDEO_ENGINE_PORT="4100"
# En Vercel: URL pública del worker en tu VPS (https://...). En local podés omitir
# o usar http://127.0.0.1:4100 (el admin spawnea el pipeline local si es localhost).
VIDEO_ENGINE_URL="http://127.0.0.1:4100"
VIDEO_STORAGE_ROOT="data/video-engine"
VIDEO_USE_FAKE_PROVIDERS="false"
OPENAI_API_KEY=""
# Guion/storyboard: gpt-5.6-terra (equilibrio). Flagship: gpt-5.6-sol o gpt-5.6. Fallback: gpt-4o
OPENAI_LLM_MODEL="gpt-5.6-terra"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="coral"
# Otras voces: marin | cedar | onyx | nova | sage
# OPENAI_TTS_INSTRUCTIONS="Narración en español rioplatense (Argentina). Cercana y con carácter, como alguien que te cuenta la historia con ganas: ritmo vivo, énfasis natural en los giros importantes, pausas cortas. Clara y creíble, sin gritar ni hacer clickbait. Pronunciación argentina (yeísmo rehilado suave, entonación porteña/rioplatense)."
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# --- Carousel engine (apps/carousel-engine) ---
# En Vercel: no hace falta vars nuevas; el admin usa VIDEO_ENGINE_URL + /carousel/*
# En local (PC): carousel en :4120; opcionalmente Next apunta directo:
# CAROUSEL_ENGINE_URL="http://127.0.0.1:4120"
CAROUSEL_ENGINE_PORT="4120"
# Opcional: si falta, hereda VIDEO_ENGINE_API_KEY
# CAROUSEL_ENGINE_API_KEY=""
CAROUSEL_STORAGE_ROOT="data/carousel-engine"
# Forzar PNG placeholder (tests / sin Chromium). En desktop: dejar false e instalar Playwright.
CAROUSEL_USE_FAKE_RENDERER="false"
# Solo video-engine: upstream del proxy /carousel/*
# CAROUSEL_ENGINE_UPSTREAM="http://127.0.0.1:4120"
