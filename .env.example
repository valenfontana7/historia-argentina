# Postgres (Neon / Prisma / cualquier proveedor)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Cookie de sesión JWT (generá uno largo: openssl rand -base64 32)
AUTH_SECRET="reemplazar-con-secreto-largo-aleatorio"

# URL pública del sitio (sin barra final)
# Hasta conectar museoargent.com.ar en Vercel, usá el *.vercel.app en producción.
NEXT_PUBLIC_SITE_URL="https://historia-argentina-woad.vercel.app"

# MercadoPago (credenciales de producción o de prueba)
MP_ACCESS_TOKEN=""

# Emails del creador: acceso admin (/admin/acceder) y precio reducido en MP (comma-separated)
MECENAS_CREATOR_EMAILS="tu@email.com"
# Monto ARS para checkout de creador (default 1)
MECENAS_CREATOR_PRECIO="1"

# Resend (emails de magic link y bienvenida)
RESEND_API_KEY=""
# Opcional: remitente verificado. Por defecto usa onboarding@resend.dev
RESEND_FROM="Argent <onboarding@resend.dev>"

# Google Search Console — meta tag de verificación (solo el código, sin comillas)
# Search Console → Configuración → Verificación → Etiqueta HTML → content="..."
GOOGLE_SITE_VERIFICATION=""
